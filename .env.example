# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection URI (e.g. postgresql://user:pass@localhost:5432/nextgen).
# If omitted or unavailable, the backend automatically uses the embedded persistent relational JSON engine.
DATABASE_URL=""

# SESSION_SECRET: Secret key used to sign and verify session JWT cookies.
SESSION_SECRET="nextgen-ai-assistant-super-secure-session-secret-change-in-prod"

# ADMIN_EMAIL: Configured email address of the system administrator.
ADMIN_EMAIL="faqruddin00000@gmail.com"

# ADMIN_PASSWORD_HASH: Pre-hashed bcrypt password for default admin account (optional).
ADMIN_PASSWORD_HASH=""

# ADMIN_SETUP_SECRET: Secret token used for initial one-time admin promotion or setup.
ADMIN_SETUP_SECRET="nextgen-admin-setup-secret-key-2025"

# Optional third-party providers (fallbacks to Gemini native integrations if unconfigured)
IMAGE_GENERATION_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
SPEECH_PROVIDER_API_KEY=""

